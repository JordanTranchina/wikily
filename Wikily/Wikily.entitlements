<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Wikily is not sandboxed, matching the posture of the Tauri build it replaces.
	  It reads a user-chosen wiki folder from arbitrary paths, creates a CoreAudio
	  aggregate device for the system-audio tap, and registers global hotkeys.
	  Hardened Runtime is on (see ENABLE_HARDENED_RUNTIME) for notarization.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- CoreAudio process tap + microphone capture. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!--
	  Two things use this. Talking to a user-run OpenAI-compatible model server
	  (Ollama :11434, LM Studio :1234, llama-server :8080) stays loopback-only.
	  The one deliberate exception is Settings › Calendar: when a user opts in
	  by connecting a Google or Outlook account, Wikily reaches Google's and
	  Microsoft's OAuth/Calendar endpoints directly to sync event times and
	  join links for the meeting-reminder notification — see
	  `docs/CALENDAR_INTEGRATION.md` and `Tech Spec Wikily.md` §6. Nothing else
	  in the app calls a remote host; call audio and transcripts still never
	  leave the machine.
	-->
	<key>com.apple.security.network.client</key>
	<true/>

	<!--
	  Wikily ships ad-hoc signed (no paid Apple Developer Program enrollment),
	  so it has no Team ID. Hardened Runtime's default Library Validation
	  requires every loaded binary to share the main executable's Team ID or be
	  signed by Apple, which would otherwise block loading Sparkle.framework.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
